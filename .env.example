# =============================================================================
# HELLO CLINICA — ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values. Never commit ".env".
# Required status per Deployment Guide + External Services Setup.
# =============================================================================

# --- Database (Supabase PostgreSQL) -----------------------------------------
# REQUIRED. Use the Supabase "Connection string" (Transaction pooler) for the
# app runtime, and DIRECT_URL (Session/Direct) for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Authentication (NextAuth) ----------------------------------------------
# REQUIRED. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="4336b00b06332d3a4a1354ffaa973fe282cb08fdf1cfdd8f8043f276afc94be8"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin bootstrap account ------------------------------------------------
# REQUIRED. The first Super Admin is seeded from these values (prisma db seed).
# ADMIN_PASSWORD_HASH is a bcrypt hash — generate with the helper script, never
# store a plaintext password. See README "Create the admin password hash".
ADMIN_EMAIL="helloqlinica@gmail.com"
ADMIN_PASSWORD_HASH="$2a$10$XtYCO3XS/huWy/i1zHlc8eBKzwQRckJWTHv2DK9BWCojsKO8jW3Ve"
ADMIN_NAME="Hello Clinica"

# --- Email delivery (Resend) — used from the phase that wires submissions ----
# Added to the env contract now so later phases need no architecture change.
# RESEND_API_KEY is REQUIRED before contact/consultation emails can send.
RESEND_API_KEY=""
# Verified sender address (must belong to a Resend-verified domain).
FROM_EMAIL="Hello Clinica <noreply@helloclinica.com>"
# Internal recipients for form notifications (frozen, per Email Templates).
NOTIFY_EMAIL_PRIMARY="helloqlinica@gmail.com"
NOTIFY_EMAIL_SECONDARY="helloqlinica@outlook.com"

# --- File storage (UploadThing) — used from the Books/Resources phases -------
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# --- Analytics (PostHog) — used from the analytics phase ---------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Public site config ------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
