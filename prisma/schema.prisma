// =============================================================================
// HELLO CLINICA — PRISMA SCHEMA
// Database: PostgreSQL · ORM: Prisma  (per System Architecture + DB Schema)
//
// The 16 tables below match DATABASE_SCHEMA.md exactly. Fields marked
// "[additive]" were NOT in the base schema doc but are required to satisfy
// other frozen documents (delivery-status logging, archive-not-delete,
// login lockout, admin-editable fields). Nothing approved was removed or
// restructured — these are forward-compatible extensions only.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  EDITOR // future
  SUPPORT // future
  CONTENT_MANAGER // future
}

enum ConsultationStatus {
  NEW
  CONTACTED
  FOLLOW_UP_REQUIRED
  CLOSED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum BookCategory {
  RECOMMENDED_BOOKS
  MEDICAL_SCHOOL_BOOKS
  NURSING_BOOKS
  NCLEX_BOOKS
  STUDY_GUIDES
  DIGITAL_DOWNLOADS
}

enum ResourceCategory {
  MEDICAL_SCHOOL_ADMISSIONS
  APPLICATION_TIMELINE
  PERSONAL_STATEMENT_GUIDE
  INTERVIEW_GUIDE
  CLINICAL_EXPERIENCE
  VOLUNTEER_GUIDE
  SHADOWING_GUIDE
  STUDY_RESOURCES
  CAREER_EXPLORATION
  NURSING_RESOURCES
  NURSING_ANATOMY
  NURSING_PHYSIOLOGY
  NURSING_PHARMACOLOGY
  NURSING_DOSAGE
  NURSING_NCLEX_SHEETS
  NURSING_LAB_VALUES
  NURSING_MED_TERMINOLOGY
  NURSING_ABBREVIATIONS
  NURSING_ASSESSMENT
  NURSING_VITAL_SIGNS
  NURSING_ECG
  NURSING_MED_ADMIN
}

enum FaqCategory {
  GENERAL
  ADMISSIONS_ADVISING
  APPLICATION_REVIEW
  INTERVIEW_COACHING
  CONSULTATION_PACKAGES
  BOOKS
  RESOURCES
  CONTACT
}

// ----------------------------------------------------------------------------
// ADMINS
// ----------------------------------------------------------------------------

model Admin {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(SUPER_ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  @@map("admins")
}

// [additive] Login throttling store — required by ADMIN_REQUIREMENTS
// "3 failed attempts -> 15 minute lockout -> audit log -> notify admin".
model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  ipAddress   String?
  successful  Boolean  @default(false)
  attemptedAt DateTime @default(now())
  lockedUntil DateTime?

  @@index([email, attemptedAt])
  @@map("login_attempts")
}

// ----------------------------------------------------------------------------
// CONSULTATIONS
// ----------------------------------------------------------------------------

model Consultation {
  id            String             @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String
  cadre         String
  contactMethod String // single selection (frozen: "Only One Selection Allowed" for cadre; contact method stored as the chosen channel)
  socialHandle  String?
  consent       Boolean            @default(false)
  message       String?
  status        ConsultationStatus @default(NEW)
  archived      Boolean            @default(false) // [additive] archive-not-delete
  emailStatus   EmailStatus        @default(PENDING) // [additive] delivery status
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("consultations")
}

// ----------------------------------------------------------------------------
// CONTACT REQUESTS
// ----------------------------------------------------------------------------

model ContactRequest {
  id             String      @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String
  cadre          String
  reason         String
  message        String
  acceptedTerms  Boolean     @default(false)
  archived       Boolean     @default(false) // [additive]
  emailStatus    EmailStatus @default(PENDING) // [additive]
  createdAt      DateTime    @default(now())

  @@index([createdAt])
  @@map("contact_requests")
}

// ----------------------------------------------------------------------------
// NEWSLETTER SUBSCRIBERS
// ----------------------------------------------------------------------------

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  consent      Boolean  @default(true) // [additive] consent statement is required
  archived     Boolean  @default(false) // [additive]
  unsubscribed Boolean  @default(false) // honoured by every campaign send
  unsubToken   String?  @unique // secret token used by the one-click unsubscribe link
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ----------------------------------------------------------------------------
// BOOKS
// ----------------------------------------------------------------------------

model Book {
  id            String        @id @default(cuid())
  title         String
  author        String
  description   String
  category      BookCategory
  coverImage    String?
  fileUrl       String?
  downloadCount Int           @default(0)
  featured      Boolean       @default(false) // [additive] admin Feature/Unfeature
  published     Boolean       @default(false)
  archived      Boolean       @default(false) // [additive]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  downloadLogs  DownloadLog[]
  audioTracks   AudioTrack[]

  @@index([category])
  @@index([published])
  @@map("books")
}

// ----------------------------------------------------------------------------
// RESOURCES
// ----------------------------------------------------------------------------

model Resource {
  id           String           @id @default(cuid())
  title        String
  description  String
  body         String? // [additive] rich article body (Content Structure: Articles)
  category     ResourceCategory
  thumbnail    String?
  resourceFile String?
  featured     Boolean          @default(false)
  published    Boolean          @default(false)
  archived     Boolean          @default(false) // [additive]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  downloadLogs DownloadLog[]

  @@index([category])
  @@index([published])
  @@map("resources")
}

// ----------------------------------------------------------------------------
// PACKAGES
// ----------------------------------------------------------------------------

model Package {
  id          String             @id @default(cuid())
  packageName String
  description String
  totalHours  Int
  totalCost   Int // stored in minor units / whole currency per admin entry
  features    String[] // feature list
  buttonText  String             @default("Proceed") // [additive] admin "Button Text"
  sortOrder   Int                @default(0) // [additive] admin "Reorder"
  published   Boolean            @default(true)
  archived    Boolean            @default(false) // [additive]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  inquiries   PackageInquiry[]

  @@index([sortOrder])
  @@map("packages")
}

// ----------------------------------------------------------------------------
// PACKAGE INQUIRIES
// ----------------------------------------------------------------------------

model PackageInquiry {
  id               String      @id @default(cuid())
  packageId        String
  studentFirstName String
  studentLastName  String
  studentEmail     String
  studentPhone     String
  message          String?
  archived         Boolean     @default(false) // [additive]
  emailStatus      EmailStatus @default(PENDING) // [additive]
  createdAt        DateTime    @default(now())

  package          Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_inquiries")
}

// ----------------------------------------------------------------------------
// TESTIMONIALS
// ----------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  program     String? // [additive] Content Structure lists "Program"
  headline    String
  content     String
  photo       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  archived    Boolean  @default(false) // [additive]
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

// ----------------------------------------------------------------------------
// FAQS
// ----------------------------------------------------------------------------

model Faq {
  id        String      @id @default(cuid())
  category  FaqCategory
  question  String
  answer    String
  sortOrder Int         @default(0) // [additive] stable ordering
  published Boolean     @default(true)
  archived  Boolean     @default(false) // [additive]
  createdAt DateTime    @default(now())

  @@index([category])
  @@map("faqs")
}

// ----------------------------------------------------------------------------
// SITE SETTINGS (single row)
// ----------------------------------------------------------------------------

model SiteSettings {
  id            String   @id @default(cuid())
  siteName      String   @default("Hello Clinica")
  siteEmail1    String   @default("helloqlinica@gmail.com")
  siteEmail2    String   @default("helloqlinica@outlook.com")
  logo          String?
  favicon       String?
  socialLinks   Json     @default("{}")
  footerText    String?  @default("Expert guidance for future healthcare professionals.") // [additive]
  copyrightText String?  @default("© Hello Clinica. All rights reserved.") // [additive]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

// ----------------------------------------------------------------------------
// AUDIT LOGS
// ----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  ipAddress String?

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// DOWNLOAD LOGS
// ----------------------------------------------------------------------------

model DownloadLog {
  id           String    @id @default(cuid())
  resourceId   String?
  bookId       String?
  downloadDate DateTime  @default(now())
  ipAddress    String?

  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  book         Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([bookId])
  @@map("download_logs")
}

// ----------------------------------------------------------------------------
// SEARCH INDEX
// ----------------------------------------------------------------------------

model SearchIndex {
  id          String   @id @default(cuid())
  contentType String
  contentId   String
  title       String
  body        String
  url         String? // [additive] direct link target for results
  createdAt   DateTime @default(now())

  @@index([contentType])
  @@map("search_index")
}

// ----------------------------------------------------------------------------
// EMAIL LOG  [additive table]
// Records every notification attempt so "store delivery status / retry on
// failure / never lose data" is auditable independent of the source record.
// ----------------------------------------------------------------------------

model EmailLog {
  id          String      @id @default(cuid())
  template    String // e.g. "contact", "consultation", "package_inquiry"
  recipients  String[]
  subject     String
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  relatedType String? // source model name
  relatedId   String? // source record id
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@map("email_logs")
}

// ============================================================
// QUESTION BANK (Drop 1) — additive; new tables only.
// ============================================================

enum QuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
}

model QuizCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  overview    String? // optional longer intro shown on the category page
  icon        String? // lucide icon name (e.g. "Stethoscope")
  parentId    String? // null = top-level; otherwise nests under another category
  order       Int      @default(0)
  featured    Boolean  @default(false)
  premium     Boolean  @default(false) // paid section — gated behind an account with access
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Restrict (not Cascade): deleting a section that still has sub-sections
  /// would silently destroy everything beneath it. The owner must empty it first.
  parent        QuizCategory?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      QuizCategory[]     @relation("CategoryTree")
  quizzes       Quiz[]
  externalLinks QuizExternalLink[]

  @@index([parentId])
  @@map("quiz_categories")
}

/// A tagged external educational resource (website/social link) shown as a rich
/// card with a thumbnail inside a Question Bank category.
model QuizExternalLink {
  id           String   @id @default(cuid())
  categoryId   String
  title        String
  url          String
  description  String?
  thumbnailUrl String?
  source       String? // display domain, e.g. "youtube.com"
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Restrict: links must be removed deliberately, not as collateral.
  category QuizCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("quiz_external_links")
}

model Quiz {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String
  categoryId       String
  kind             String   @default("PRACTICE") // PRACTICE | EXAM
  difficulty       String   @default("Mixed")
  timeLimitSeconds Int? // null = untimed
  passThreshold    Int      @default(65) // percent needed to "pass"
  published        Boolean  @default(false)
  featured         Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Restrict: never let deleting a section quietly delete months of quiz authoring.
  category QuizCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([categoryId])
  @@index([published])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  type        QuestionType @default(SINGLE)
  stem        String // the question text
  topic       String       @default("General") // drives the per-topic report
  explanation String // rationale: correct answer + why others are wrong + summary
  points      Int          @default(1)
  order       Int          @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]

  @@index([quizId])
  @@map("questions")
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("choices")
}

model QuizAttempt {
  id               String   @id @default(cuid())
  quizId           String
  userId           String? // null when not signed in
  studentId        String? // linked student account (signed-in attempts)
  mode             String   @default("timed")
  kind             String   @default("PRACTICE") // snapshot of the quiz type at attempt time
  score            Int // percent 0-100
  correctCount     Int
  totalQuestions   Int
  passed           Boolean  @default(false)
  timeSpentSeconds Int      @default(0)
  topicBreakdown   Json? // { topic: { correct, total } }
  answers          Json? // { questionId: [choiceIds] } snapshot for review
  createdAt        DateTime @default(now())

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([userId])
  @@index([studentId])
  @@map("quiz_attempts")
}

// ─────────────────────────────────────────────────────────────
// STUDENT ACCOUNTS (Slice 3) — separate from admin auth
// ─────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  university   String?
  hasAccess    Boolean  @default(false) // admin grants after payment (manual for now)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests CourseAccessRequest[]
  attempts QuizAttempt[]
  readerNotes ReaderNote[]
  resetTokens PasswordResetToken[]
  audioProgress AudioProgress[]

  @@map("students")
}

model CourseAccessRequest {
  id         String   @id @default(cuid())
  studentId  String?
  name       String
  email      String
  university String
  course     String
  message    String?
  status     String   @default("pending") // pending | contacted | granted | closed
  createdAt  DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("course_access_requests")
}

// ─────────────────────────────────────────────────────────────
// READER NOTES (Drop C) — highlights & notes saved while reading
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// READER NOTES (Drop C) — personal study notes on books/resources
// ─────────────────────────────────────────────────────────────

model ReaderNote {
  id         String   @id @default(cuid())
  studentId  String
  itemType   String // "book" | "resource"
  itemId     String
  page       Int? // optional page reference
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, itemType, itemId])
  @@map("reader_notes")
}

// ─────────────────────────────────────────────────────────────
// EMAIL: campaigns + password resets
// ─────────────────────────────────────────────────────────────

/// A newsletter written in the admin and sent to all active subscribers.
model NewsletterCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String // HTML or plain text written by the admin
  status      String    @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("newsletter_campaigns")
}

/// Single-use, expiring token for student password resets.
model PasswordResetToken {
  id        String   @id @default(cuid())
  studentId String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("password_reset_tokens")
}


// ─────────────────────────────────────────────────────────────
// AUDIO BOOKS
// A book can have any number of audio tracks (chapters). Each track is either
// an uploaded file or a link to an external audiobook — the player treats both
// the same way, so the owner can mix them freely.
// ─────────────────────────────────────────────────────────────

model AudioTrack {
  id     String @id @default(cuid())
  bookId String
  title  String // e.g. "Chapter 3 — Fluid & Electrolyte Balance"
  order  Int    @default(0)

  /// Uploaded audio (streamed through /api/read-audio so the real URL stays hidden)
  audioUrl String?
  /// OR a link to an audiobook hosted elsewhere (opens externally)
  externalUrl String?
  /// "upload" | "external" — kept explicit so the UI never has to guess
  source String @default("upload")

  durationSeconds Int? // shown in the track list; optional
  narrator        String?
  published       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress AudioProgress[]

  @@index([bookId])
  @@index([published])
  @@map("audio_tracks")
}

/// Where each student left off in each track.
/// The @@unique constraint is deliberate: it makes duplicate progress rows
/// impossible, so listening stats can never double-count or conflict.
model AudioProgress {
  id              String   @id @default(cuid())
  studentId       String
  trackId         String
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  listenCount     Int      @default(0)
  updatedAt       DateTime @updatedAt

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  track   AudioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([studentId, trackId])
  @@index([trackId])
  @@map("audio_progress")
}
